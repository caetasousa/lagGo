# Para rodar a API fora do Docker (make backend-run), com os bancos no compose.
# Os TESTES não leem este arquivo: usam bancos efêmeros (internal/testinfra).
POSTGRES_URL=postgres://marketplace:marketplace@localhost:5432/marketplace?sslmode=disable
MONGO_URI=mongodb://localhost:27017/?directConnection=true
REDIS_ADDR=localhost:6379
RATE_LIMIT_POR_MINUTO=30
# Opcionais — só a partir da Fase 7 (docker compose --profile nosql up -d)
# CASSANDRA_HOSTS=localhost
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_PASSWORD=marketplace123

# Fase 6: chave do CPF cifrado (pgcrypto). Só de desenvolvimento.
CPF_CHAVE=chave-de-desenvolvimento-nao-use-em-producao
