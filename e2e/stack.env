# Ambiente do stack de E2E: docker compose -p nosqlgo-e2e --env-file e2e/stack.env
#
# Portas próprias: o stack de E2E sobe AO LADO do de desenvolvimento.
# Nada aqui é segredo — é um banco que nasce e morre a cada execução.
WEB_PORT=23000
API_PORT=28080
POSTGRES_PORT=25432
POSTGRES_REPLICA_PORT=25433
MONGO_PORT=27117
REDIS_PORT=26379
PGBOUNCER_PORT=26432
HAPROXY_STATS_PORT=27000

# Os testes saem todos do mesmo IP (o container do Playwright): um limite
# baixo faria a suíte falhar com 429 sem nada estar quebrado. O 429 em si é
# coberto no teste de integração (internal/app).
RATE_LIMIT_POR_MINUTO=100000
CASSANDRA_PORT=29042
NEO4J_HTTP_PORT=27474
NEO4J_BOLT_PORT=27687
